<!-- mdBook 0.5 includes theme/head.hbs inside <head> on every page; everything
     else in the theme is mdBook's default. The per-page metadata a search
     engine, a link unfurler or an agent reads (title, description, canonical,
     the markdown twin, Open Graph, Twitter card, JSON-LD) is written after the
     build by tools/page_meta.py, which replaces the defaults below. -->
<meta property="og:type" content="article">
<meta property="og:site_name" content="How Java Minecraft Works">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
